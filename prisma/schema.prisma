generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Food {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("Food") // Stores 'Food', 'Drinks', 'Fruits', etc.
  price       Float
  description String
  status      String   @default("Available")
  imageUrl    String
  variations  Json?    // Stores the list of sizes/prices for drinks/fruits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}